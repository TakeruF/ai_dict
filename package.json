{
  "name": "ai-dict",
  "version": "0.4.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/takeru/ai_dict.git"
  },
  "homepage": "https://aidict.me",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export": "next build",
    "start": "next start",
    "lint": "eslint",
    "ios:build": "npm run build && npx cap build ios",
    "ios:open": "npx cap open ios",
    "ios:sync": "npx cap sync ios",
    "cap:add:ios": "npx cap add ios",
    "android:build": "npm run export && npx cap sync android && npx cap build android",
    "android:open": "npx cap open android",
    "android:sync": "npx cap sync android",
    "android:release": "npm run export && npx cap sync android && cd android && ./gradlew assembleRelease",
    "apk:build": "./scripts/build-android-apk.sh",
    "apk:deploy": "npm run apk:build && echo 'APK ready for download at /releases/ai-dict.apk'",
    "release:create": "./scripts/create-release.sh",
    "release:beta": "./scripts/create-release.sh v$(jq -r '.version' package.json)-beta",
    "release:patch": "npm version patch && ./scripts/create-release.sh v$(jq -r '.version' package.json)",
    "release:minor": "npm version minor && ./scripts/create-release.sh v$(jq -r '.version' package.json)",
    "release:major": "npm version major && ./scripts/create-release.sh v$(jq -r '.version' package.json)"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.1.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "3.3.17"
  }
}
